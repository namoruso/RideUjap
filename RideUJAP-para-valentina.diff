+export function clerkActivo(): boolean {
+  return Boolean(clerkPublishableKey)
+}
+
+/** Apariencia alineada a --ride-green (#0b6e4f) */
+export const clerkAppearance = {
+  variables: {
+    colorPrimary: '#0b6e4f',
