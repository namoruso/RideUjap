// RideUJAP — Prisma schema (PostgreSQL)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  clerkId        String?  @unique
  nombre         String
  correo         String   @unique
  telefono       String   @default("")
  esConductor    Boolean  @default(false)
  /// Null cuando el usuario entra solo con Clerk
  contrasenaHash String?
  correoVerificado Boolean @default(false)

  /// false = debe pasar por /onboarding (viajero vs conductor)
  onboardingCompleto Boolean @default(false)

  // Perfil del vehículo (conductores)
  marcaVehiculo  String?
  placa          String?
  modeloVehiculo String?
  colorVehiculo  String?
  puestosVehiculo Int?

  creadoEn DateTime @default(now())

  viajes  Viaje[]         @relation("Conductor")
  uniones PasajeroViaje[]
}

model Viaje {
  id                  Int      @id @default(autoincrement())
  origen              String
  destino             String
  puntoEncuentro      String?
  fecha               String
  hora                String
  cuposTotal          Int
  cuposDisponibles    Int
  descripcionVehiculo String
  estado              String   @default("disponible")

  // Coordenadas Google Maps (estado Carabobo)
  origenLat  Float?
  origenLng  Float?
  destinoLat Float?
  destinoLng Float?

  creadoEn DateTime @default(now())

  idConductor Int
  conductor   Usuario @relation("Conductor", fields: [idConductor], references: [id])

  pasajeros PasajeroViaje[]
}

model PasajeroViaje {
  id      Int      @id @default(autoincrement())
  unidoEn DateTime @default(now())

  idUsuario Int
  usuario   Usuario @relation(fields: [idUsuario], references: [id])

  idViaje Int
  viaje   Viaje @relation(fields: [idViaje], references: [id])

  @@unique([idUsuario, idViaje])
}
