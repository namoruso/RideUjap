PORT=3001

# PostgreSQL — local (Docker Compose: host=localhost cuando la API corre en el host)
DATABASE_URL=postgresql://rideujap:rideujap@localhost:5433/rideujap?schema=public
DIRECT_URL=postgresql://rideujap:rideujap@localhost:5433/rideujap?schema=public

# PostgreSQL — Supabase (Dashboard → Connect → ORMs → Prisma)
#   DATABASE_URL: pooler (puerto 6543), para la API en runtime
#   DIRECT_URL:   conexión directa/session pooler (puerto 5432), para db push / migraciones
# DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# MongoDB (notificaciones). Vacío = notificaciones desactivadas, el resto de la API funciona.
# Atlas → Connect → Drivers. Ej: mongodb+srv://usuario:clave@cluster.mongodb.net
# MONGODB_URI=
# MONGODB_DB=rideujap

# Auth local (JWT) — sigue válido mientras migramos a Clerk
JWT_SECRET=cambia-este-secreto-largo-en-desarrollo

# Clerk (opcional en local). Dashboard → API Keys
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# En el Dashboard: Allowlist → dominio ujap.edu.ve + verificación de email

# Email (recuperación JWT / SMTP)
# EMAIL_USER=
# EMAIL_PASS=
